{
  "name": "vi-editor",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/vi-editor.umd.js",
  "module": "./dist/vi-editor.es.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vi-editor.es.js",
      "require": "./dist/vi-editor.umd.js",
      "types": "./index.d.ts"
    },
    "./style.css": "./dist/vi-editor.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --emitDeclarationOnly --declaration --outDir dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "katex": "^0.18.4",
    "lucide-vue-next": "^1.0.0"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.11"
  }
}
